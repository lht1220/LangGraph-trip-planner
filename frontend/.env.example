# 后端API地址
VITE_API_BASE_URL=http://localhost:8000

# 高德地图Web API Key (后端使用，前端不读取，仅作参考/历史保留)
VITE_AMAP_WEB_KEY=your_key

# 高德地图Web端JS API Key (前端地图使用，必须是「Web端(JS API)」类型 Key)
VITE_AMAP_WEB_JS_KEY=your_key
# 高德 JS API 安全密钥（2021-12 之后申请的 Key 必须填，否则地图加载失败；老 Key 留空即可）
VITE_AMAP_SECURITY_CODE=your_security_code
